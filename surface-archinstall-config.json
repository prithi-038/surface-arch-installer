{
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": true,
    "removable": false
  },
  "kernels": [
    "linux"
  ],
  "locale_config": {
    "kb_layout": "uk",
    "sys_enc": "UTF-8",
    "sys_lang": "en_GB"
  },
  "network_config": {
    "type": "nm"
  },
  "packages": [
    "btrfs-progs",
    "cryptsetup",
    "firefox",
    "intel-ucode",
    "mkinitcpio",
    "sbctl",
    "sudo",
    "systemd-ukify",
    "tpm2-tss"
  ],
  "profile_config": {
    "gfx_driver": "Intel (open-source)",
    "greeter": "plasma-login-manager",
    "profile": {
      "custom_settings": {
        "KDE Plasma": {
          "plasma_flavor": "plasma-meta"
        }
      },
      "details": [
        "KDE Plasma"
      ],
      "main": "Desktop"
    }
  },
  "script": "guided",
  "silent": false,
  "swap": {
    "enabled": true,
    "algorithm": "zstd"
  },
  "timezone": "Asia/Dhaka",
  "version": "2.8.6"
}
